# Copy to .env and adjust. Never commit .env.
PORT=4000

# Project-local MySQL instance (see scripts/db-start.sh, DECISIONS.md D-006)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=yaleclubs

# Change this to a long random string before deploying anywhere real.
JWT_SECRET=dev-only-change-me-please-0123456789
JWT_EXPIRES_IN=7d

# Client origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173
