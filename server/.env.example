# Copy to .env and adjust. Never commit .env.
PORT=4000
NODE_ENV=development

# Project-local MySQL instance (see scripts/db-start.sh, DECISIONS.md D-006)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=yaleclubs

# Change this to a long random string before deploying anywhere real.
# The server refuses to start in production if it is short or still the default.
JWT_SECRET=dev-only-change-me-please-0123456789
JWT_EXPIRES_IN=7d

# Where the browser app runs; used for CORS and CAS redirects.
CLIENT_ORIGIN=http://localhost:5173
# This server's externally reachable base URL (the CAS `service` parameter).
SERVER_PUBLIC_URL=http://localhost:4000

# ---------------------------------------------------------------- Yale CAS
# mock = local stand-in login page, works offline, no registration needed.
# yale = the real Yale CAS. Requires Yale ITS to register SERVER_PUBLIC_URL
#        as an authorized service first — see DECISIONS.md D-017.
CAS_MODE=mock
CAS_BASE_URL=https://secure.its.yale.edu/cas

# ---------------------------------------------------------------- ClubWiz
# With a key, ClubWiz answers with Claude over the catalog (tool use).
# Without one it falls back to a deterministic catalog lookup — still useful.
# ANTHROPIC_API_KEY=sk-ant-...
CLUBWIZ_MODEL=claude-opus-5
CLUBWIZ_EFFORT=low
