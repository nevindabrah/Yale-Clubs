# dependencies
node_modules/

# secrets — .env.example is committed instead
.env
.env.local
*.local

# build output
dist/
build/

# project-local MySQL instance (D-006) — never commit a database
server/mysql-data/
server/mysql-run/
server/.conda-mysql/

# logs
*.log
npm-debug.log*

# macOS
.DS_Store

# ---- secrets hardening (D-023) ----
# Broad env coverage: every variant, at any depth, in one rule.
.env
.env.*
!.env.example
!*.env.example

# Keys, certificates, and credential dumps
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
id_ed25519*
secrets.json
credentials.json
service-account*.json

# Tool-local credential caches
.npmrc
.netrc
.anthropic
.aws/
.ssh/
